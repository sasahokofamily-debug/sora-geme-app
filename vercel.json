{
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/game", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/landing.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
      ]
